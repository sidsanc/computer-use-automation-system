{
  "$defs": {
    "AppBinding": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Product",
          "type": "string"
        },
        "versions": {
          "description": "Version range of the vendor product, e.g. '>=7.2,<8'.",
          "title": "Versions",
          "type": "string"
        }
      },
      "required": [
        "product",
        "versions"
      ],
      "title": "AppBinding",
      "type": "object"
    },
    "Click": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "click",
          "default": "click",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Click",
      "type": "object"
    },
    "Css": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "css",
          "default": "css",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "brittle": {
          "const": true,
          "default": true,
          "title": "Brittle",
          "type": "boolean"
        }
      },
      "required": [
        "selector"
      ],
      "title": "Css",
      "type": "object"
    },
    "DialogPresent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "dialog_present",
          "default": "dialog_present",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "DialogPresent",
      "type": "object"
    },
    "ElementPresent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "element_present",
          "default": "element_present",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target"
      ],
      "title": "ElementPresent",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Route relative to the tenant's base URL.",
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "Entry",
      "type": "object"
    },
    "Extract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "extract",
          "default": "extract",
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "output"
      ],
      "title": "Extract",
      "type": "object"
    },
    "FieldValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "field_value",
          "default": "field_value",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "equals": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputRef"
            },
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "$ref": "#/$defs/LiteralValue"
            }
          ],
          "title": "Equals"
        }
      },
      "required": [
        "target",
        "equals"
      ],
      "title": "FieldValue",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fill",
          "default": "fill",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputRef"
            },
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "$ref": "#/$defs/LiteralValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fill",
      "type": "object"
    },
    "FrameUrl": {
      "additionalProperties": false,
      "description": "Path of a frame's URL; ``*`` matches one path segment.",
      "properties": {
        "kind": {
          "const": "frame_url",
          "default": "frame_url",
          "title": "Kind",
          "type": "string"
        },
        "frame_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Frame Path",
          "type": "array"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "FrameUrl",
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "description": "Detector for a known runtime state and what replay does about it.\n\nPrecedence when several fire at once: escalate > hard_failure > business_outcome > recoverable.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "business_outcome",
            "recoverable",
            "escalate",
            "hard_failure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "when": {
          "items": {
            "discriminator": {
              "mapping": {
                "dialog_present": "#/$defs/DialogPresent",
                "element_present": "#/$defs/ElementPresent",
                "field_value": "#/$defs/FieldValue",
                "frame_url": "#/$defs/FrameUrl",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementPresent"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/FrameUrl"
              },
              {
                "$ref": "#/$defs/DialogPresent"
              }
            ]
          },
          "minItems": 1,
          "title": "When",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "kind",
        "when",
        "message"
      ],
      "title": "Handler",
      "type": "object"
    },
    "Idempotency": {
      "additionalProperties": false,
      "description": "How to tell that this write already happened.\n\nA timeout is not proof that nothing happened: the request may have reached the core while the\nresponse was lost. Rather than guess, a write step can declare observable evidence that the work\nlanded. Replay checks it before dispatching (so a retry cannot double-post) and again when the\npostcondition times out, turning an ambiguous write into a decided one.",
      "properties": {
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "dialog_present": "#/$defs/DialogPresent",
                "element_present": "#/$defs/ElementPresent",
                "field_value": "#/$defs/FieldValue",
                "frame_url": "#/$defs/FrameUrl",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementPresent"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/FrameUrl"
              },
              {
                "$ref": "#/$defs/DialogPresent"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "timeout_s": {
          "default": 15,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "evidence"
      ],
      "title": "Idempotency",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Input",
          "type": "string"
        }
      },
      "required": [
        "input"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "money"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "sensitivity": {
          "default": "public",
          "enum": [
            "public",
            "pii"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "LabelNeighbor": {
      "additionalProperties": false,
      "description": "Unlabelled control identified by the caption in the neighbouring table cell.",
      "properties": {
        "kind": {
          "const": "label_neighbor",
          "default": "label_neighbor",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "role",
        "label"
      ],
      "title": "LabelNeighbor",
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "literal": {
          "title": "Literal",
          "type": "string"
        }
      },
      "required": [
        "literal"
      ],
      "title": "LiteralValue",
      "type": "object"
    },
    "LocatorCandidate": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "discriminator": {
            "mapping": {
              "css": "#/$defs/Css",
              "label_neighbor": "#/$defs/LabelNeighbor",
              "role_name": "#/$defs/RoleName",
              "table_cell": "#/$defs/TableCell",
              "text": "#/$defs/Text"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RoleName"
            },
            {
              "$ref": "#/$defs/LabelNeighbor"
            },
            {
              "$ref": "#/$defs/TableCell"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Css"
            }
          ],
          "title": "Locator"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "rationale"
      ],
      "title": "LocatorCandidate",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "money"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "sensitivity": {
          "default": "public",
          "enum": [
            "public",
            "pii",
            "financial"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "PressKey": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "press_key",
          "default": "press_key",
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "enum": [
            "Enter",
            "Tab",
            "Escape"
          ],
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "PressKey",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "llm_discovery",
            "hand_authored"
          ],
          "title": "Method",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "recorder_version": {
          "title": "Recorder Version",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_template_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Hash"
        },
        "step_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Count"
        },
        "token_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transcript_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Ref"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why a human changed the recorded flow, if they did.",
          "title": "Notes"
        }
      },
      "required": [
        "method",
        "recorded_at",
        "recorder_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Recovery": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "dismiss",
            "reauth_and_restart",
            "recheck"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "Recovery",
      "type": "object"
    },
    "RequestHuman": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "request_human",
          "default": "request_human",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RequestHuman",
      "type": "object"
    },
    "RoleName": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "role_name",
          "default": "role_name",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "RoleName",
      "type": "object"
    },
    "RowMatch": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "equals": {
          "title": "Equals",
          "type": "string"
        }
      },
      "required": [
        "column",
        "equals"
      ],
      "title": "RowMatch",
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "Resolved from the secret store at the moment of typing; never logged, stored or shown to a model.",
      "properties": {
        "secret": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Secret",
          "type": "string"
        }
      },
      "required": [
        "secret"
      ],
      "title": "SecretRef",
      "type": "object"
    },
    "Select": {
      "additionalProperties": false,
      "description": "Choose an option by its visible label.",
      "properties": {
        "kind": {
          "const": "select",
          "default": "select",
          "title": "Kind",
          "type": "string"
        },
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputRef"
            },
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "$ref": "#/$defs/LiteralValue"
            }
          ],
          "title": "Option"
        }
      },
      "required": [
        "option"
      ],
      "title": "Select",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^s\\d{2}_[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "action": {
          "discriminator": {
            "mapping": {
              "click": "#/$defs/Click",
              "extract": "#/$defs/Extract",
              "fill": "#/$defs/Fill",
              "press_key": "#/$defs/PressKey",
              "request_human": "#/$defs/RequestHuman",
              "select": "#/$defs/Select",
              "wait_for": "#/$defs/WaitFor"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Click"
            },
            {
              "$ref": "#/$defs/Fill"
            },
            {
              "$ref": "#/$defs/Select"
            },
            {
              "$ref": "#/$defs/PressKey"
            },
            {
              "$ref": "#/$defs/WaitFor"
            },
            {
              "$ref": "#/$defs/Extract"
            },
            {
              "$ref": "#/$defs/RequestHuman"
            }
          ],
          "title": "Action"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pre": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "dialog_present": "#/$defs/DialogPresent",
                "element_present": "#/$defs/ElementPresent",
                "field_value": "#/$defs/FieldValue",
                "frame_url": "#/$defs/FrameUrl",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementPresent"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/FrameUrl"
              },
              {
                "$ref": "#/$defs/DialogPresent"
              }
            ]
          },
          "title": "Pre",
          "type": "array"
        },
        "post": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "dialog_present": "#/$defs/DialogPresent",
                "element_present": "#/$defs/ElementPresent",
                "field_value": "#/$defs/FieldValue",
                "frame_url": "#/$defs/FrameUrl",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementPresent"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/FrameUrl"
              },
              {
                "$ref": "#/$defs/DialogPresent"
              }
            ]
          },
          "title": "Post",
          "type": "array"
        },
        "effect": {
          "enum": [
            "none",
            "navigation",
            "write"
          ],
          "title": "Effect",
          "type": "string"
        },
        "irreversible": {
          "default": false,
          "title": "Irreversible",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout S",
          "type": "number"
        },
        "handlers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Handler"
          },
          "title": "Handlers",
          "type": "array"
        },
        "idempotency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Idempotency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "performed_by": {
          "default": "automation",
          "enum": [
            "automation",
            "human"
          ],
          "title": "Performed By",
          "type": "string"
        }
      },
      "required": [
        "id",
        "intent",
        "action",
        "effect"
      ],
      "title": "Step",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "description": "Cell addressed by column header plus a key cell in the same row, never by its own value or index.",
      "properties": {
        "kind": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Kind",
          "type": "string"
        },
        "column": {
          "title": "Column",
          "type": "string"
        },
        "row": {
          "$ref": "#/$defs/RowMatch"
        }
      },
